# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy these values from
# Project Settings → API. Run supabase/schema.sql in the SQL editor to set up
# the database, RLS policies, and the storage bucket.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── NVIDIA NIM ─────────────────────────────────────────────────────────────────
# No server-side AI key is needed. Each user enters their NVIDIA NIM Build API
# key in-app after signing in (Settings → AI). It is stored in the browser only
# and relayed per-request — it is never persisted on the server.
