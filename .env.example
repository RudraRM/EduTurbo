# ── Supabase ──────────────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy these values from
# Project Settings → API. Run supabase/schema.sql in the SQL editor to set up
# the database, RLS policies, and the storage bucket.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── Groq ──────────────────────────────────────────────────────────────────────
# No server-side AI key is needed. Every user brings their own Groq API key,
# entered in-app (Settings → AI). Keys are stored in the user's browser only
# and relayed per-request — they are never persisted on the server.
